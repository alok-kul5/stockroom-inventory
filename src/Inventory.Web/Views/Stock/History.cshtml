@model MovementHistoryViewModel
@{ ViewData["Title"] = "Movements"; }
<h1>Stock movements</h1>

<form method="get" class="d-flex gap-2 mb-3 flex-wrap">
    <select name="type" class="form-select" style="max-width:180px" aria-label="Movement type">
        <option value="">All types</option>
        @foreach (var t in Enum.GetValues<MovementType>())
        {
            <option value="@t" selected="@(Model.Type == t)">@t</option>
        }
    </select>
    <select name="productId" class="form-select" style="max-width:320px" aria-label="Product">
        <option value="">All products</option>
        @foreach (var p in Model.Products)
        {
            <option value="@p.Value" selected="@(Model.ProductId?.ToString() == p.Value)">@p.Text</option>
        }
    </select>
    <button class="btn btn-outline-secondary">Filter</button>
</form>

<div class="panel p-0">
    <partial name="_Movements" model="Model.Rows" />
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Pages">
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-route-page="@i" asp-route-type="@Model.Type" asp-route-productId="@Model.ProductId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
