@model Location
@{ ViewData["Title"] = "Add location"; }
<h1>Add location</h1>
<form asp-action="Create" method="post" class="panel" style="max-width:560px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control sku" style="text-transform:uppercase" autocomplete="off" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <button class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
