@model Product
@{ ViewData["Title"] = $"Edit {Model.Sku}"; }
<h1>Edit <span class="sku">@Model.Sku</span></h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel">
    <partial name="_Form" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
