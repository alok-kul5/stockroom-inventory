@model IReadOnlyList<StockMovement>
@{
    var showProduct = ViewData["ShowProduct"] as bool? ?? true;
}
@if (Model.Count == 0)
{
    <p class="text-muted mb-0">No movements yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>When (UTC)</th>
                    <th>Type</th>
                    @if (showProduct) { <th>Product</th> }
                    <th>From</th>
                    <th>To</th>
                    <th class="num">Qty</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="text-nowrap">@m.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge badge-type badge-@m.Type">@m.Type</span></td>
                        @if (showProduct)
                        {
                            <td><a class="sku" asp-controller="Products" asp-action="Details" asp-route-id="@m.ProductId">@m.Product?.Sku</a></td>
                        }
                        <td class="sku">@(m.FromLocation?.Code ?? "—")</td>
                        <td class="sku">@(m.ToLocation?.Code ?? "—")</td>
                        <td class="num">@m.Quantity</td>
                        <td class="text-muted">@m.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
