<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Stockroom</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container d-flex align-items-center gap-4">
            <a class="brand" asp-controller="Home" asp-action="Index">Stockroom</a>
            <nav class="d-flex gap-3 flex-wrap">
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="Products" asp-action="Index">Products</a>
                <a asp-controller="Locations" asp-action="Index">Locations</a>
                <a asp-controller="Stock" asp-action="History">Movements</a>
            </nav>
            <a class="btn btn-sm btn-primary ms-auto" asp-controller="Stock" asp-action="Move">Record movement</a>
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success py-2" role="status">@flash</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger py-2" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
