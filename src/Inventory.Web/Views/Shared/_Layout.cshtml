<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Stockroom</title>
    <link rel="icon" href="~/img/mark.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400..600&family=Hanken+Grotesk:wght@400..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var section = ViewContext.RouteData.Values["controller"] as string;
    string Nav(string c) => section == c ? "active" : "";
}
<body class="@(section == "Home" ? "is-home" : "")">
    <header class="topbar">
        <div class="frame topbar-row">
            <a class="brand" asp-controller="Home" asp-action="Index"><img src="~/img/mark.svg" alt="" width="28" height="28" />Stockroom</a>
            <nav aria-label="Main">
                <a class="@Nav("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="@Nav("Products")" asp-controller="Products" asp-action="Index">Products</a>
                <a class="@Nav("Locations")" asp-controller="Locations" asp-action="Index">Locations</a>
                <a class="@Nav("Stock")" asp-controller="Stock" asp-action="History">Movements</a>
            </nav>
            <a class="btn btn-sm btn-primary topbar-action" asp-controller="Stock" asp-action="Move">Record movement</a>
        </div>
    </header>

    <main class="frame page">
        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success py-2" role="status">@flash</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger py-2" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
